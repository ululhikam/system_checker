# Salin file ini lalu ubah namanya menjadi .env di folder backend.

# Gemini API Keys (Mendukung banyak key untuk rotasi otomatis jika terkena Limit 429)
# Opsi A: Gunakan koma untuk mendaftarkan beberapa API Key sekaligus:
GEMINI_API_KEYS="AIzaSy1...,AIzaSy2...,AIzaSy3..."

# Opsi B: Atau daftarkan baris per baris:
GEMINI_API_KEY="AIzaSyPrimary..."
GEMINI_API_KEY_2="AIzaSyBackup1..."
GEMINI_API_KEY_3="AIzaSyBackup2..."

# Google Fact Check API Key
GOOGLE_FACT_CHECK_API_KEY=""

# DeepSeek AI / OpenRouter API Key
DEEPSEEK_API_KEY=""

# VirusTotal Cyber Security API Key
VIRUSTOTAL_API_KEY=""